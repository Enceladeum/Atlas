<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>atlas</AssemblyName>
    <RootNamespace>Atlas.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InformationalVersion>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))Z</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Atlas.Core/Atlas.Core.csproj" />
  </ItemGroup>
  <!-- Lumina flows transitively from Core in source mode; in prebuilt-dll mode reference it here too -->
  <ItemGroup Condition="'$(LuminaDll)'!=''">
    <Reference Include="Lumina">
      <HintPath>$(LuminaDll)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="../Atlas.Core/Lgb/leveldirs.txt" Link="leveldirs.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
